{
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "rewrites": [
        {
            "source": "/api/((?!checkout|contact).*)",
            "destination": "https://treetino-pricing.vercel.app/api/$1"
        },
        {
            "source": "/app/(.*)",
            "destination": "/app/index.html"
        },
        {
            "source": "/app",
            "destination": "/app/index.html"
        },
        {
            "source": "/((?!api|app|build|img|video|docs|models|.*\\.pdf$|favicon.ico|apple-touch-icon.png|robots.txt).*)",
            "destination": "/index.html"
        }
    ]
}
